<odoo>
    <record id="view_ai_insight_wizard_form" model="ir.ui.view">
        <field name="name">ai.erp.insight.wizard.form</field>
        <field name="model">ai.erp.insight.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Business Insights">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Generates rule-based alerts for overdue customer invoices and zero/negative free stock in up to 500 active products. These checks do not replace accounting review or a full audit.
                    </div>
                    <group><field name="company_id"/></group>
                </sheet>
                <footer>
                    <button name="action_generate_insights" type="object" string="Run Checks" class="oe_highlight"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_ai_insight_wizard" model="ir.actions.act_window">
        <field name="name">Generate Business Insights</field>
        <field name="res_model">ai.erp.insight.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
