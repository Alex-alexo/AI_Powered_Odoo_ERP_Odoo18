<odoo>
    <record id="view_ai_erp_conversation_list" model="ir.ui.view">
        <field name="name">ai.erp.conversation.list</field>
        <field name="model">ai.erp.conversation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>
    <record id="view_ai_erp_conversation_form" model="ir.ui.view">
        <field name="name">ai.erp.conversation.form</field>
        <field name="model">ai.erp.conversation</field>
        <field name="arch" type="xml">
            <form string="AI Business Assistant">
                <header>
                    <button name="action_send_message" type="object" string="Send to AI" class="oe_highlight" invisible="state != 'open'"/>
                    <button name="action_close_conversation" type="object" string="Close Conversation" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id" readonly="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Ask a business question">
                        <field name="new_message" placeholder="Example: Summarize our posted customer invoices for the last 30 days." nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Conversation History">
                            <field name="message_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="create_date"/>
                                    <field name="role"/>
                                    <field name="content" widget="text"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ai_erp_conversations" model="ir.actions.act_window">
        <field name="name">AI Business Assistant</field>
        <field name="res_model">ai.erp.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_name': 'New AI conversation'}</field>
    </record>
</odoo>
