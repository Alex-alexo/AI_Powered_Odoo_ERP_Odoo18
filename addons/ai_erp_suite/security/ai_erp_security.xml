<odoo>
    <record id="module_category_ai_erp" model="ir.module.category">
        <field name="name">AI ERP</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_ai_erp_user" model="res.groups">
        <field name="name">AI ERP User</field>
        <field name="category_id" ref="module_category_ai_erp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ai_erp_manager" model="res.groups">
        <field name="name">AI ERP Manager</field>
        <field name="category_id" ref="module_category_ai_erp"/>
        <field name="implied_ids" eval="[(4, ref('ai_erp_suite.group_ai_erp_user'))]"/>
    </record>

    <record id="rule_ai_config_company" model="ir.rule">
        <field name="name">AI provider configuration: allowed companies</field>
        <field name="model_id" ref="model_ai_erp_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ai_erp_suite.group_ai_erp_manager'))]"/>
    </record>
    <record id="rule_ai_conversation_own" model="ir.rule">
        <field name="name">AI conversations: own records</field>
        <field name="model_id" ref="model_ai_erp_conversation"/>
        <field name="domain_force">[('user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ai_erp_suite.group_ai_erp_user'))]"/>
    </record>
    <record id="rule_ai_conversation_manager" model="ir.rule">
        <field name="name">AI conversations: manager company records</field>
        <field name="model_id" ref="model_ai_erp_conversation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ai_erp_suite.group_ai_erp_manager'))]"/>
    </record>
    <record id="rule_ai_message_own" model="ir.rule">
        <field name="name">AI messages: own conversations</field>
        <field name="model_id" ref="model_ai_erp_message"/>
        <field name="domain_force">[('conversation_id.user_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ai_erp_suite.group_ai_erp_user'))]"/>
    </record>
    <record id="rule_ai_message_manager" model="ir.rule">
        <field name="name">AI messages: manager company records</field>
        <field name="model_id" ref="model_ai_erp_message"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ai_erp_suite.group_ai_erp_manager'))]"/>
    </record>
    <record id="rule_ai_insight_company" model="ir.rule">
        <field name="name">AI insights: allowed companies</field>
        <field name="model_id" ref="model_ai_erp_insight"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ai_erp_suite.group_ai_erp_user'))]"/>
    </record>
    <record id="rule_ai_forecast_company" model="ir.rule">
        <field name="name">AI forecasts: allowed companies</field>
        <field name="model_id" ref="model_ai_erp_forecast"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('ai_erp_suite.group_ai_erp_user'))]"/>
    </record>
</odoo>
